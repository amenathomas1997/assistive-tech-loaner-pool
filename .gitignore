# Runtime configuration, uploads and update artefacts.
# config.json holds database credentials and the key that encrypts stored
# secrets; uploads/ holds client condition photos and signatures; and the
# updater writes version.json and backup-*.zip here. None of it belongs in
# version control, ever.
data/

node_modules/
*.log

# Local editor and agent settings — machine-specific, not part of the project.
.claude/
.vscode/
.idea/
.DS_Store

# Deployment notes containing account-specific details — never commit these.
*.local.md

# PHP
/vendor/
